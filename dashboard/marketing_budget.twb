          <zone h='36198' w='24158' x='50073' y='57292' id='30' name='Budget curve' />
          <zone h='36198' w='24012' x='74817' y='57292' id='31' name='Plan summary' />
          <zone h='5729' w='97657' x='1171' y='94010' id='32' type-v2='text'>
            <formatted-text>
