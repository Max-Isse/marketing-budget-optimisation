      <column caption='Verdict group' datatype='string' name='[Calculation_0226836252082185]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([verdict], &quot;increase&quot;) THEN &quot;increase&quot; ELSEIF CONTAINS([verdict], &quot;cut&quot;) THEN &quot;cut&quot; ELSE &quot;depends on assumptions&quot; END' />
      </column>
      <column caption='Verdict x evidence' datatype='string' name='[Calculation_0226836252213258]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0226836252082185] + &quot; / &quot; + [evidence]' />
      </column>
      <column caption='Change %' datatype='real' default-format='p0%' name='[Calculation_0226836252397579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([change]) / SUM([last_year_split])' />
      </column>
