      <column caption='Plan gain' datatype='real' default-format='c"$"#,##0,"k";-"$"#,##0,"k"' name='[Calculation_0226836250021890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(IF [allocation]=&quot;recommended&quot; THEN [expected_profit] END) } - { FIXED : SUM(IF [allocation]=&quot;status_quo&quot; THEN [expected_profit] END) }' />
      </column>
      <column caption='Plan downside gain' datatype='real' default-format='c"$"#,##0,"k";-"$"#,##0,"k"' name='[Calculation_0226836250611716]' role='measure' type='quantitative'>
