    <worksheet name='Rollout'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b0b0b' fontsize='11'>What to do about each test · yearly value is an assumption</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Experiments' name='federated.1mchob20rczqe91b6o6jc169xwch' />
          </datasources>
          <datasource-dependencies datasource='federated.1mchob20rczqe91b6o6jc169xwch'>
              <column caption='Yearly value' datatype='string' name='[Calculation_9000000000000015]' role='dimension' type='nominal'>
                <calculation class='tableau' formula='&quot;$&quot; + STR(INT(ROUND([annual_value_estimate] / 1000))) + &quot;k&quot; + &quot; a year (range &quot; + &quot;$&quot; + STR(INT(ROUND([annual_value_low] / 1000))) + &quot;k&quot; + &quot; to &quot; + &quot;$&quot; + STR(INT(ROUND([annual_value_high] / 1000))) + &quot;k&quot; + &quot;)&quot;' />
              </column>
              <column caption='Has rollout decision' datatype='boolean' name='[Calculation_9000000000000023]' role='dimension' type='nominal'>
                <calculation class='tableau' formula='NOT ISNULL([rollout_decision])' />
              </column>
