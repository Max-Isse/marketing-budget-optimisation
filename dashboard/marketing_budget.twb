    <worksheet name='CAC comparison'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b0b0b' fontsize='11'>Platform CAC vs last-click CAC · Attribution</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Weekly channel' name='federated.02ca4hv0mt8djp17fr9wh1mutmpr' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='federated.02ca4hv0mt8djp17fr9wh1mutmpr'>
              <column caption='Platform CAC' datatype='real' default-format='c"$"#,##0;-"$"#,##0' name='[Calculation_0226836253143055]' role='measure' type='quantitative'>
                <calculation class='tableau' formula='SUM([spend]) / SUM([platform_conversions])' />
              </column>
              <column caption='Last-click CAC' datatype='real' default-format='c"$"#,##0;-"$"#,##0' name='[Calculation_0226836253298704]' role='measure' type='quantitative'>
                <calculation class='tableau' formula='SUM([spend]) / SUM([crm_customers])' />
              </column>
              <column caption='Business selected' datatype='boolean' name='[Calculation_9000000000000002]' role='dimension' type='nominal'>
                <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;All&quot; OR LEFT([Parameters].[Parameter 1], 2) = [business]' />
              </column>
              <column caption='In date range' datatype='boolean' name='[Calculation_9000000000000011]' role='dimension' type='nominal'>
                <calculation class='tableau' formula='[week_start] &gt; DATEADD(&apos;week&apos;, -[Parameters].[Parameter 4], { FIXED : MAX([week_start]) })' />
              </column>
              <column caption='Line Label' datatype='string' name='[line_label]' role='dimension' type='nominal' />
              <column-instance column='[Calculation_9000000000000002]' derivation='None' name='[none:Calculation_9000000000000002:nk]' pivot='key' type='nominal' />
