        <calculation class='tableau' formula='[target] = CASE [Parameters].[Parameter 3] WHEN &quot;New customers&quot; THEN &quot;customers&quot; WHEN &quot;Revenue&quot; THEN &quot;revenue&quot; WHEN &quot;Contribution profit&quot; THEN &quot;contribution_profit&quot; WHEN &quot;Ad spend&quot; THEN &quot;spend&quot; END' />
