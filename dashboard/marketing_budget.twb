          <zone h='42969' w='97657' x='1171' y='20052' id='40' name='Lenses' />
          <zone h='29688' w='40996' x='1171' y='63802' id='41' name='CAC comparison' />
          <zone h='29688' w='56076' x='42753' y='63802' id='42' name='Next tests' />
          <zone h='5729' w='97657' x='1171' y='94010' id='43' type-v2='text'>
            <formatted-text>
            <run fontcolor='#52514e' fontsize='9'>Platform = what the ad platform claims. Last click = what our CRM credits. Randomised test = what switching spend on and off in regions actually changed. Model = what the next dollar is expected to buy.</run>
            </formatted-text>
          </zone>
        </zone>
      </zones>
