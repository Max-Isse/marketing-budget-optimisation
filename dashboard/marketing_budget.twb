      <column caption='Week Start' datatype='date' name='[week_start]' role='dimension' type='ordinal' />
      <column caption='Business selected' datatype='boolean' name='[Calculation_9000000000000009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;All&quot; OR LEFT([Parameters].[Parameter 1], 2) = [business]' />
      </column>
      <column caption='In date range' datatype='boolean' name='[Calculation_9000000000000012]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[week_start] &gt; DATEADD(&apos;week&apos;, -[Parameters].[Parameter 4], { FIXED : MAX([week_start]) })' />
      </column>
      <column caption='Data flag' datatype='string' name='[Calculation_9000000000000025]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tracking_outage] THEN &quot;tracking outage&quot; ELSEIF [attribution_changed] THEN &quot;tracking change&quot; ELSE &quot;no flag&quot; END' />
      </column>
