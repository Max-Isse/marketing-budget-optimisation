      <column caption='Attribution ratio' datatype='table' name='[__tableau_internal_object_id__].[synthetic_attribution_ratio_weekly.csv_04EF396700B4411BB4161138A3E0B686]' role='measure' type='quantitative' />
      <column caption='Platform/CRM ratio' datatype='real' default-format='n#,##0.00' name='[Calculation_0226836254392342]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([platform_conversions]) / SUM([crm_customers])' />
      </column>
      <column caption='Attribution Changed' datatype='boolean' name='[attribution_changed]' role='dimension' type='nominal' />
      <column caption='Business' datatype='string' name='[business]' role='dimension' type='nominal' />
