      <column caption='Band low' datatype='real' name='[Calculation_0226836253601809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [series]=&quot;forecast&quot; THEN [low] END' />
      </column>
      <column caption='Band width' datatype='real' name='[Calculation_0226836253769746]' role='measure' type='quantitative'>
