          <zone h='6250' w='97657' x='1171' y='8073' id='56' type-v2='text'>
            <formatted-text>
            <run fontcolor='#0b0b0b' fontsize='11'>The new B1 landing page lifts conversion by 6.6% (range 2.9% to 10.5%): launch it. Switching off B3 retargeting cost no measurable customers.</run>
            </formatted-text>
          </zone>
          <zone h='42969' w='97657' x='1171' y='20052' id='57' name='Effects' />
